# Copy to .env. No vendor keys here any more: speech-to-text and rewriting go through Supabase Edge Functions
# that the signed-in account unlocks, and the keys live there as function secrets.
#
# What is left is developer tuning, read only in development.

# Soniox (development and the demo build): key in reference/secrets/soniox.key, read at start —
# an India-region project's key. With it, dictation transcribes on Soniox instead of Gnani.
# Optional model override, defaults to stt-rt-v6.
SONIOX_MODEL=
# Gnani, the released app's speech-to-text through the backend.
# Optional recognition locale, defaults to hi-IN. One locale only.
# Others: bn-IN en-IN gu-IN kn-IN ml-IN mr-IN pa-IN ta-IN te-IN
GNANI_LANGUAGE=hi-IN
# Optional model override, defaults to prisma-v3.0.
GNANI_MODEL=
# Optional output style: verbatim | transcribe | codemix | transliterate.
GNANI_FORMAT=
# Optional rewriting model, defaults to google/gemini-3.5-flash-lite (gpt-oss-120b is the fallback).
OPENROUTER_MODEL=
# Celeris (development): key in reference/secrets/celeris.key, read at start. With it, dictation
# rewrites through Celeris first. Optional model for that, defaults to celeris-1.
CELERIS_MODEL=
# Optional classic Follow My Words models as provider:model, development only. With the Celeris key
# they default to celeris:celeris-1.1-decision and celeris:celeris-1; without it (and always in the
# installed app) to jev:typesafe/jev-1.14 and openrouter:google/gemini-2.5-flash via the backend.
DECIDER_MODEL=
COMMAND_MODEL=
# Optional assistant (Follow My Words) model as provider:model, development only; defaults to
# celeris:celeris-1, with bedrock:us.moonshotai.kimi-k3.1 as the fallback (key in
# reference/secrets/bedrock.key). Also: celeris:celeris-1-magnus. The installed app always
# runs openrouter:anthropic/claude-haiku-5.5, with openrouter:anthropic/claude-sonnet-5.5 as fallback.
# Qwen3-235B is in Mumbai only: bedrock:qwen.qwen3-235b-a22b-2507-v1:0 with AWS_REGION=ap-south-1.
ASSISTANT_MODEL=
# Optional model the same run continues on after a provider error or a stuck self-check.
ASSISTANT_FALLBACK_MODEL=
