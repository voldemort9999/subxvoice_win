{
  "name": "@subx/desktop",
  "productName": "SUBXVoice",
  "version": "0.4.3",
  "private": true,
  "description": "SUBXVoice desktop app",
  "author": "SUBXVoice",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist:win": "node scripts/build-icon.mjs && electron-vite build && electron-builder --win --publish never",
    "test": "vitest run",
    "release:win": "node scripts/release.mjs",
    "build:icon": "node scripts/build-icon.mjs"
  },
  "devDependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/noto-sans-devanagari": "^5.3.0",
    "@fontsource/dm-mono": "^5.3.0",
    "@subx/core": "workspace:*",
    "@subx/platform-win": "workspace:*",
    "@subx/providers": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.11",
    "electron-vite": "^5.0.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "koffi": "^3.3.2"
  }
}
